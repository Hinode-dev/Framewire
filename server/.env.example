# Copy to .env (docker compose loads .env from this directory automatically).
#
# There is no TURN relay, so nothing here is required by default: backend
# hands viewer browsers a public STUN server (see FW_STUN_SERVER default in
# backend/src/config.rs). Only set this if you want to point at a different
# STUN server.
#FW_STUN_SERVER=stun.l.google.com:19302

# Shared secret framewire.exe must send as `x-framewire-host-token` to open
# a room. Leaving this unset means anyone who knows the backend URL can
# connect as a host — set this for any real deployment.
#FW_HOST_TOKEN=

# Minimum accepted framewire.exe version (e.g. "0.2.0"). Hosts on an older
# (or unreported) build are rejected before a room is created.
#FW_MIN_HOST_VERSION=
