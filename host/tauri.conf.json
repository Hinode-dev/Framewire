{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Framewire",
  "identifier": "com.hinodeent.framewire",
  "build": {
    "frontendDist": "gui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Framewire",
        "width": 560,
        "height": 760,
        "minWidth": 480,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
